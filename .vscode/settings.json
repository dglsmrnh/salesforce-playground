{
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/.sf": true,
    "**/.sfdx": true
  },
  "xml.preferences.showSchemaDocumentationType": "none",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[apex]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  "psi-header.config": {
    "author": "dglsmrnh"
  },
  "psi-header.changes-tracking": {
    "isActive": true,
    "autoHeader": "autoSave",
    "enforceHeader": true,
    "modAuthor": "Modified By:",
    "modDate": "Last Modified:",
    "modDateFormat": "dd/MM/yyyy HH:mm:ss",
    "exclude": [
      "json",
      "jsonc",
      "markdown",
      "yaml",
      "plaintext",
      "xml"
    ],
    "includeGlob": [
      "force-app/main/default/**/*"
    ]
  },
  "psi-header.lang-config": [
    {
      "language": ".cls",
      "begin": "/**",
      "prefix": " * ",
      "end": " */",
      "forceToTop": true
    },
    {
      "language": ".trigger",
      "begin": "/**",
      "prefix": " * ",
      "end": " */",
      "forceToTop": true
    },
    {
      "language": "javascript",
      "begin": "/**",
      "prefix": " * ",
      "end": " */",
      "forceToTop": true
    },
    {
      "language": "html",
      "begin": "<!--",
      "prefix": " ",
      "suffix": "",
      "end": "-->",
      "forceToTop": true
    },
    {
      "language": "css",
      "begin": "/**",
      "prefix": " * ",
      "end": " */",
      "forceToTop": true
    }
  ],
  "psi-header.templates": [
    {
      "language": ".cls",
      "template": [
        "@description       : <<filename>>",
        "@author            : <<author>>",
        "@created           : <<filecreated('DD/MM/YYYY HH:mm:ss')>>",
        "@last modified on  : <<dateformat('DD/MM/YYYY HH:mm:ss')>>",
        "@last modified by  : <<author>>"
      ]
    },
    {
      "language": ".trigger",
      "template": [
        "@description       : <<filename>>",
        "@author            : <<author>>",
        "@created           : <<filecreated('DD/MM/YYYY HH:mm:ss')>>",
        "@last modified on  : <<dateformat('DD/MM/YYYY HH:mm:ss')>>",
        "@last modified by  : <<author>>"
      ]
    },
    {
      "language": "javascript",
      "template": [
        "@description       : <<filename>>",
        "@author            : <<author>>",
        "@created           : <<filecreated('DD/MM/YYYY HH:mm:ss')>>",
        "@last modified on  : <<dateformat('DD/MM/YYYY HH:mm:ss')>>",
        "@last modified by  : <<author>>"
      ]
    },
    {
      "language": "html",
      "template": [
        "Component: <<filename>>",
        "Author: <<author>>",
        "Created: <<filecreated('DD/MM/YYYY HH:mm:ss')>>",
        "Last Modified: <<dateformat('DD/MM/YYYY HH:mm:ss')>>"
      ]
    },
    {
      "language": "css",
      "template": [
        "@description       : <<filename>>",
        "@author            : <<author>>",
        "@created           : <<filecreated('DD/MM/YYYY HH:mm:ss')>>",
        "@last modified on  : <<dateformat('DD/MM/YYYY HH:mm:ss')>>",
        "@last modified by  : <<author>>"
      ]
    }
  ],
  "sonarlint.connectedMode.project": {
    "connectionId": "dglsmrnh",
    "projectKey": "dglsmrnh_salesforce-playground"
  }
}